{
  "name": "trucklook",
  "version": "0.2.0",
  "description": "Webcam tabanli ETS2/ATS kafa ve goz takipcisi",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "ErcanDuman",
  "license": "MIT",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run assets && vite build",
    "test": "vitest run --config vitest.config.js",
    "package": "npm run test && npm run build && electron-builder --win portable",
    "dist": "npm run test && npm run build && electron-builder --win nsis portable",
    "prepare:github": "node scripts/prepare-github.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.trucklook.app",
    "productName": "TruckLook",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "TruckLook-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TruckLook"
    }
  }
}
